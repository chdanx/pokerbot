TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Публичный домен, указывающий A-записью на IP-адрес сервера.
# Caddy сам выпустит и продлит HTTPS-сертификат.
APP_DOMAIN=poker.example.com

# Период, по которому строится текущая таблица сезона.
SEASON_START=2025-06-01
SEASON_END=2025-12-31

# UID и GID пользователя на сервере, которому принадлежит каталог ./data.
# Узнать их можно командой: id -u && id -g
# Если не указать значения, Docker Compose использует 1000:1000.
BOT_UID=1000
BOT_GID=1000
